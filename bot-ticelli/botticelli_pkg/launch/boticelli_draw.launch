<launch>
  <!--
    Launch del mode dibuix amb mapa existent.

    Obre localitzacio sobre un mapa guardat, visio i els tres nodes del dibuix.
    Aquest mode s'utilitza quan ja tenim un .yaml/.pgm i volem dibuixar sense repetir SLAM.
  -->

  <arg name="model" default="waffle"/>
  <arg name="use_rviz" default="true"/>

  <!-- Mapa que es carrega amb map_server. La interfÃ­cie pot sobreescriure aquest arg. -->
  <arg name="map_file" default="$(find botticelli_pkg)/maps/mapa_aula2.yaml"/>

  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>

  <!-- Mapa i localitzacio: map_server publica /map i AMCL estima la pose del robot. -->
  <include file="$(find botticelli_pkg)/launch/localization.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="use_move_base" value="false"/>
  </include>

  <!-- Visio: extreu el contorn de la figura a partir de la camera. -->
  <include file="$(find botticelli_pkg)/launch/vision.launch"/>

  <!-- Dibuix: planner genera path, navigator va al punt inicial i follower dibuixa. -->
  <include file="$(find botticelli_pkg)/launch/drawing.launch"/>
</launch>
