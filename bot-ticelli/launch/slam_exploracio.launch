<launch>
    <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="model type [burger, waffle, waffle_pi]"/>


    <!-- Dimensions del dibuix -->
    <arg name="drawing_width" default="0.40"/>
    <arg name="drawing_height" default="0.30"/>
    <arg name="safety_margin" default="0.10"/>


    <!-- Temps de SLAM/exploració -->
    <arg name="min_explore_time" default="30.0"/>
    <arg name="max_explore_time" default="60.0"/>
    <arg name="map_stable_time" default="12.0"/>
    <arg name="rviz" default="true"/>


    <!-- Landmarks: valors conservadors per evitar massa deteccions repetides -->
    <arg name="landmark_min_distance" default="0.50"/>
    <arg name="landmark_min_time" default="5.0"/>
    <arg name="feature_landmark_min_distance" default="0.45"/>
    <arg name="feature_landmark_min_time" default="1.0"/>
    <arg name="obstacle_landmark_max_range" default="1.20"/>
    <arg name="corner_landmark_max_range" default="1.80"/>
    <arg name="corner_jump_threshold" default="1.00"/>
    <arg name="wall_landmark_max_range" default="2.50"/>
    <arg name="wall_split_jump" default="0.20"/>
    <arg name="wall_min_length" default="0.45"/>
    <arg name="wall_max_fit_error" default="0.04"/>
    <arg name="wall_corner_angle_threshold" default="0.70"/>
    <arg name="wall_min_points" default="8"/>
    <arg name="max_wall_landmarks" default="20"/>
    <arg name="max_corner_landmarks" default="12"/>
    <arg name="max_obstacle_landmarks" default="8"/>


    <!-- Nom del mapa guardat -->
    <arg name="map_output_file" default="$(find bot-ticelli)/maps/mapa_boticelli_real"/>


    <!-- Seguint l'estructura de la P3: remote + gmapping -->
    <include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch" />


    <!-- SLAM: crea /map a partir de /scan, /odom i /tf -->
    <node pkg="gmapping"
          type="slam_gmapping"
          name="slam_gmapping"
          output="screen">


        <param name="base_frame" value="base_link"/>
        <param name="odom_frame" value="odom"/>
        <param name="map_frame" value="map"/>


        <param name="map_update_interval" value="2.0"/>
        <param name="maxUrange" value="4.0"/>
        <param name="minimumScore" value="100"/>
        <param name="linearUpdate" value="0.2"/>
        <param name="angularUpdate" value="0.2"/>
        <param name="temporalUpdate" value="0.5"/>
        <param name="delta" value="0.05"/>
        <param name="lskip" value="0"/>
        <param name="particles" value="120"/>


        <param name="sigma" value="0.05"/>
        <param name="kernelSize" value="1"/>
        <param name="lstep" value="0.05"/>
        <param name="astep" value="0.05"/>
        <param name="iterations" value="5"/>
        <param name="lsigma" value="0.075"/>
        <param name="ogain" value="3.0"/>


        <param name="srr" value="0.01"/>
        <param name="srt" value="0.02"/>
        <param name="str" value="0.01"/>
        <param name="stt" value="0.02"/>
        <param name="resampleThreshold" value="0.5"/>


        <param name="xmin" value="-10.0"/>
        <param name="ymin" value="-10.0"/>
        <param name="xmax" value="10.0"/>
        <param name="ymax" value="10.0"/>


        <param name="llsamplerange" value="0.01"/>
        <param name="llsamplestep" value="0.01"/>
        <param name="lasamplerange" value="0.005"/>
        <param name="lasamplestep" value="0.005"/>
    </node>


    <!-- Node propi: mou el robot, explora, guarda mapa, calcula zona i hi va -->
    <node pkg="bot-ticelli"
          type="trobar_espai_lliure"
          name="trobar_espai_lliure"
          output="screen">


        <param name="drawing_width" value="$(arg drawing_width)"/>
        <param name="drawing_height" value="$(arg drawing_height)"/>
        <param name="safety_margin" value="$(arg safety_margin)"/>


        <param name="min_explore_time" value="$(arg min_explore_time)"/>
        <param name="max_explore_time" value="$(arg max_explore_time)"/>
        <param name="map_stable_time" value="$(arg map_stable_time)"/>


        <param name="auto_save_map" value="true"/>
        <param name="map_output_file" value="$(arg map_output_file)"/>


        <param name="landmark_min_distance" value="$(arg landmark_min_distance)"/>
        <param name="landmark_min_time" value="$(arg landmark_min_time)"/>
        <param name="feature_landmark_min_distance" value="$(arg feature_landmark_min_distance)"/>
        <param name="feature_landmark_min_time" value="$(arg feature_landmark_min_time)"/>
        <param name="obstacle_landmark_max_range" value="$(arg obstacle_landmark_max_range)"/>
        <param name="corner_landmark_max_range" value="$(arg corner_landmark_max_range)"/>
        <param name="corner_jump_threshold" value="$(arg corner_jump_threshold)"/>
        <param name="wall_landmark_max_range" value="$(arg wall_landmark_max_range)"/>
        <param name="wall_split_jump" value="$(arg wall_split_jump)"/>
        <param name="wall_min_length" value="$(arg wall_min_length)"/>
        <param name="wall_max_fit_error" value="$(arg wall_max_fit_error)"/>
        <param name="wall_corner_angle_threshold" value="$(arg wall_corner_angle_threshold)"/>
        <param name="wall_min_points" value="$(arg wall_min_points)"/>
        <param name="max_wall_landmarks" value="$(arg max_wall_landmarks)"/>
        <param name="max_corner_landmarks" value="$(arg max_corner_landmarks)"/>
        <param name="max_obstacle_landmarks" value="$(arg max_obstacle_landmarks)"/>


        <param name="occupied_threshold" value="20"/>
        <param name="goal_tolerance" value="0.18"/>


        <param name="max_linear_speed" value="0.20"/>
        <param name="max_angular_speed" value="0.30"/>
    </node>


    <!-- RViz: visualitza /map, /scan, TF i el model mentre gmapping construeix el mapa -->
    <node if="$(arg rviz)"
          pkg="rviz"
          type="rviz"
          name="rviz"
          args="-d $(find bot-ticelli)/rviz/slam_exploracio.rviz"/>
</launch>


