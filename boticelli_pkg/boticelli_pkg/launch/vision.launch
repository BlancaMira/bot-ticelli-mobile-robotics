<launch>
  <!--
    Node de visio.

    Llegeix la camera comprimida, detecta el contorn de la figura i publica
    /contour_points i /contour_info quan rep l'ordre /capture_contour.
  -->

  <node pkg="boticelli_pkg"
        type="vision_node"
        name="vision_node"
        output="screen">

    <!-- Parametres de segmentacio, morfologia i visualitzacio OpenCV. -->
    <rosparam file="$(find boticelli_pkg)/config/vision_params.yaml"
              command="load"/>
  </node>
</launch>