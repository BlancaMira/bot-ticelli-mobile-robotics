<launch>
  <arg name="model" default="waffle"/>
  <arg name="use_rviz" default="true"/>
  <arg name="map_file" default="$(find boticelli_pkg)/maps/mapa_aula2.yaml"/>

  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>

  <!-- Mapa i localització -->
  <include file="$(find boticelli_pkg)/launch/localization.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="use_move_base" value="false"/>
  </include>

  <!-- Visió -->
  <include file="$(find boticelli_pkg)/launch/vision.launch"/>

  <!-- Planner + navigator + follower -->
  <include file="$(find boticelli_pkg)/launch/drawing.launch"/>
</launch>
