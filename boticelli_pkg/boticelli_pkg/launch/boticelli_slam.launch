<launch>
  <arg name="model" default="waffle"/>
  <arg name="use_remote" default="false"/>
  <arg name="use_rviz" default="true"/>

  <!-- Mida mínima de zona lliure necessària per poder dibuixar -->
  <arg name="drawing_width" default="0.40"/>
  <arg name="drawing_height" default="0.30"/>
  <arg name="safety_margin" default="0.10"/>

  <!-- Temps de mapatge -->
  <arg name="min_explore_time" default="40.0"/>
  <arg name="max_explore_time" default="60.0"/>
  <arg name="map_stable_time" default="12.0"/>

  <!-- Nom del mapa que després utilitza el mode de dibuix -->
  <arg name="map_output_file" default="$(find boticelli_pkg)/maps/mapa_aula2"/>
  <arg name="features_output_file" default="$(arg map_output_file)_features.txt"/>

  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>

  <!-- Només activar si no s'ha llançat turtlebot3_remote.launch en una altra terminal -->
  <include if="$(arg use_remote)"
           file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch"/>

  <!-- SLAM amb gmapping -->
  <node pkg="gmapping"
        type="slam_gmapping"
        name="slam_gmapping"
        output="screen">

    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>

    <param name="map_update_interval" value="2.0"/>
    <param name="maxUrange" value="4.0"/>
    <param name="minimumScore" value="100"/>

    <param name="linearUpdate" value="0.2"/>
    <param name="angularUpdate" value="0.2"/>
    <param name="temporalUpdate" value="0.5"/>

    <param name="delta" value="0.05"/>
    <param name="particles" value="120"/>

    <param name="xmin" value="-10.0"/>
    <param name="ymin" value="-10.0"/>
    <param name="xmax" value="10.0"/>
    <param name="ymax" value="10.0"/>
  </node>

  <!-- Node propi que mou el robot, evita obstacles, guarda el mapa i busca zona lliure -->
  <node pkg="boticelli_pkg"
        type="free_space_explorer_node"
        name="free_space_explorer_node"
        output="screen">

    <param name="drawing_width" value="$(arg drawing_width)"/>
    <param name="drawing_height" value="$(arg drawing_height)"/>
    <param name="safety_margin" value="$(arg safety_margin)"/>

    <param name="min_explore_time" value="$(arg min_explore_time)"/>
    <param name="max_explore_time" value="$(arg max_explore_time)"/>
    <param name="map_stable_time" value="$(arg map_stable_time)"/>

    <param name="auto_save_map" value="true"/>
    <param name="map_output_file" value="$(arg map_output_file)"/>
    <param name="features_output_file" value="$(arg features_output_file)"/>
    <!-- Compatibilitat amb el nom antic del paràmetre -->
    <param name="landmarks_output_file" value="$(arg features_output_file)"/>

    <param name="occupied_threshold" value="20"/>
    <param name="goal_tolerance" value="0.18"/>

    <param name="max_linear_speed" value="0.20"/>
    <param name="max_angular_speed" value="0.30"/>
  </node>

  <node if="$(arg use_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        output="log"
        args="-d $(find boticelli_pkg)/config/boticelli.rviz"/>
</launch>
