<launch>
  <arg name="x" default="-0.5"/>
  <arg name="y" default="-4.6"/>

  <node pkg="rostopic"
        type="rostopic"
        name="publish_drawing_center"
        args="pub /boticelli/drawing_center geometry_msgs/PoseStamped
        '{header: {frame_id: map},
          pose: {position: {x: $(arg x), y: $(arg y), z: 0.0},
                 orientation: {x: 0.0, y: 0.0, z: 0.0, w: 1.0}}}' -r 1"
        output="screen" />
</launch>
