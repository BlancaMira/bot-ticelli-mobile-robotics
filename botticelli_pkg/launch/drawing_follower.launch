<launch>
  <!--
    Follower del dibuix.

    Executa el /drawing_path quan arriba /start_drawing. Publica /executed_path
    per comparar la trajectoria real, /drawing_progress per la barra de progres
    i /drawing_finished quan acaba.
  -->

  <node pkg="botticelli_pkg"
        type="drawing_follower_node"
        name="drawing_follower_node"
        output="screen">

    <!-- Parametres de seguiment, cantonades, velocitats i pausa per obstacle frontal. -->
    <rosparam file="$(find botticelli_pkg)/config/drawing_follower_params.yaml"
              command="load"/>
  </node>
</launch>
